# Required: secret used to sign session cookies. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=replace-me-with-a-32-plus-character-random-string

# Database connection (libsql / SQLite-compatible).
# Local development: leave blank or use file:./data/app.db
# Production (Vercel + Turso): paste your libsql URL and auth token from Turso.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Optional: Anthropic API key for AI-generated monthly summaries.
# If unset, the system falls back to a deterministic templated summary.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model override (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
